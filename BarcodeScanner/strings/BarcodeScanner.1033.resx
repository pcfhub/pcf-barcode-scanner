    <value>Barcode Scanner</value>
  </data>
  <data name="BarcodeScanner_Desc" xml:space="preserve">
    <value>A text field with a device barcode/QR scan button.</value>
  </data>

  <data name="Value_Name" xml:space="preserve">
    <value>Value</value>
  </data>
  <data name="Value_Desc" xml:space="preserve">
    <value>The scanned or typed code.</value>
